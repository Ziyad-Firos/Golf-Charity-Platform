{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build --workspace=server",
  "outputDirectory": "server/dist",
  "installCommand": "npm install --workspaces",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server/api/index.ts"
    }
  ]
}
